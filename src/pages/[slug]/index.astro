---
import Layout from '../../layouts/Layout.astro';
import Calculator from '../../components/Calculator.tsx';
import { gameInitials, gameUrl, getGames } from '../../lib/games';
import { TILE_COLORS } from '../../lib/colors';
import type { Game } from '../../lib/game-schema';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game, i) => ({
    params: { slug: `${game.slug}-score-calculator` },
    props: { game, games, tile: TILE_COLORS[i % TILE_COLORS.length] },
  }));
}

const { game, games, tile } = Astro.props as { game: Game; games: Game[]; tile: string };
const url = new URL(gameUrl(game.slug), Astro.site).href;
const others = games.filter((g) => g.slug !== game.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${game.name} Score Calculator`,
    url,
    description: game.metaDescription,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'MeepleMath', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: `${game.name} Score Calculator`, item: url },
    ],
  },
  ...(game.faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: game.faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<Layout title={game.metaTitle} description={game.metaDescription} schema={schema}>
  <nav class="text-sm font-semibold text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-accent">All calculators</a> <span aria-hidden="true">›</span> {game.name}
  </nav>
  <div class="mt-3 flex items-start gap-4">
    <span
      class="hidden h-20 w-20 shrink-0 -rotate-6 items-center justify-center rounded-3xl border-[2.5px] border-ink font-display text-3xl font-bold shadow-[4px_4px_0_var(--color-ink)] sm:flex"
      style={{ background: tile }}
      aria-hidden="true"
    >
      {gameInitials(game.name)}
    </span>
    <div>
      <h1 class="font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{game.name} Score Calculator</h1>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="pill">👥 {game.players.min}–{game.players.max} players</span>
        <span class="pill">📶 Works offline</span>
        <span class="pill">🔒 Nothing leaves your device</span>
      </div>
    </div>
  </div>
  <p class="mt-5 max-w-3xl text-lg text-muted">{game.intro}</p>

  <div class="mt-8">
    <Calculator client:load game={game} />
  </div>

  <article class="chunk prose-mm mt-14 p-6 sm:p-10">
    {
      game.rules.map((section, i) => (
        <section>
          <h2 class={i === 0 ? '!mt-0' : ''}>{section.heading}</h2>
          {section.body.map((p) => <p>{p}</p>)}
        </section>
      ))
    }

    <h2>Breaking ties</h2>
    <p>{game.tiebreaker}</p>

    {
      game.expansions.length > 0 && (
        <>
          <h2>Supported expansions</h2>
          {game.expansions.map((e) => (
            <>
              <h3>{e.name}</h3>
              <p>{e.description}</p>
            </>
          ))}
        </>
      )
    }
  </article>

  {
    game.faq.length > 0 && (
      <section class="mt-12">
        <h2 class="font-display text-3xl font-semibold">{game.name} scoring questions</h2>
        <div class="mt-4 space-y-3">
          {game.faq.map((f) => (
            <details class="chunk group rounded-2xl p-0 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center gap-3 p-4 font-display text-lg font-semibold">
                <span class="flex-1">{f.q}</span>
                <span class="text-2xl transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="px-4 pb-4 text-[1.05rem] leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="mt-14">
        <h2 class="font-display text-2xl font-semibold">More score calculators</h2>
        <ul class="mt-4 flex flex-wrap gap-3">
          {others.map((g) => (
            <li>
              <a href={gameUrl(g.slug)} class="btn bg-surface py-2 text-base">
                {g.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
