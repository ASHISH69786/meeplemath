---
import Layout from '../layouts/Layout.astro';
import { gameInitials, gameUrl, getGames } from '../lib/games';
import { TILE_COLORS, PLAYER_COLORS } from '../lib/colors';

const games = await getGames();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'MeepleMath',
    url: new URL('/', Astro.site).href,
  },
];
const features = [
  { emoji: '📶', title: 'Works at the table', text: 'Add MeepleMath to your home screen and it keeps working with no signal.' },
  { emoji: '🏆', title: 'History & win stats', text: 'Save each game to see who wins most often, best scores and averages.' },
  { emoji: '🔒', title: 'Private by design', text: 'No sign-up. Your games are stored in your own browser, not on a server.' },
];
---

<Layout
  title="MeepleMath: Free Board Game Score Calculators"
  description="Free score calculators for popular board games, with expansions, the scoring rules explained, saved game history and player stats. Works offline at the table."
  schema={schema}
>
  <section class="relative grid items-center gap-8 py-6 md:grid-cols-[1.4fr_1fr]">
    <div>
      <p class="pill bg-sun">🎲 Free · No sign-up · Works offline</p>
      <h1 class="mt-5 font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
        Who won? <br /><span class="relative inline-block">
          <span class="absolute inset-x-0 bottom-1 -z-10 h-4 rounded-full bg-sun sm:h-5"></span>Let's count.
        </span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        Pick your game, tap in each player's points and get the final ranking instantly. Every calculator covers the
        popular expansions and explains the scoring rules in plain English.
      </p>
      <a href="#games" class="btn mt-7 bg-accent text-on-accent">Choose a game ↓</a>
    </div>

    <!-- decorative meeples, pure CSS/SVG, no game art -->
    <div class="hidden justify-center md:flex" aria-hidden="true">
      <div class="grid grid-cols-3 gap-3 rotate-3">
        {
          PLAYER_COLORS.slice(0, 6).map((c, i) => (
            <svg viewBox="0 0 64 64" width="92" height="92" class={i % 2 ? 'translate-y-5 -rotate-6' : 'rotate-6'}>
              <path
                fill={c.bg}
                stroke="#1e1b2e"
                stroke-width="3"
                stroke-linejoin="round"
                d="M32 6a8 8 0 0 0-8 8c0 2.2.9 4.2 2.3 5.6C19.6 21 12 23.9 12 28c0 2.6 3.1 3.8 7.6 3.6L14 46a3 3 0 0 0 3 3h9.5a2 2 0 0 0 1.8-1.1L32 40l3.7 7.9a2 2 0 0 0 1.8 1.1H47a3 3 0 0 0 3-3l-5.6-14.4c4.5.2 7.6-1 7.6-3.6 0-4.1-7.6-7-14.3-8.4A8 8 0 0 0 32 6z"
              />
            </svg>
          ))
        }
      </div>
    </div>
  </section>

  <section id="games" class="mt-12 scroll-mt-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-semibold">Pick your game <span class="text-muted">({games.length})</span></h2>
      <label class="w-full sm:w-72">
        <span class="sr-only">Search games</span>
        <input
          id="game-search"
          type="search"
          placeholder="🔍 Search games…"
          autocomplete="off"
          class="w-full rounded-2xl border-[2.5px] border-ink bg-surface px-4 py-2.5 text-lg shadow-[3px_3px_0_var(--color-ink)] focus:outline-none focus:ring-4 focus:ring-sun"
        />
      </label>
    </div>
    <p id="no-results" class="mt-5 hidden text-muted">No game matches that. More calculators are on the way!</p>
    <ul id="game-list" class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        games.map((g, i) => (
          <li data-name={g.name.toLowerCase()}>
            <a
              href={gameUrl(g.slug)}
              class="chunk group flex h-full items-center gap-4 p-4 transition hover:-translate-y-1 hover:shadow-[6px_6px_0_var(--color-ink)]"
            >
              <span
                class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border-[2.5px] border-ink font-display text-2xl font-bold transition group-hover:-rotate-6"
                style={{ background: TILE_COLORS[i % TILE_COLORS.length] }}
                aria-hidden="true"
              >
                {gameInitials(g.name)}
              </span>
              <span class="min-w-0">
                <span class="block font-display text-xl font-semibold leading-tight">{g.name}</span>
                <span class="mt-1 block text-sm text-muted">
                  👥 {g.players.min}–{g.players.max} players
                </span>
                {g.expansions.length > 0 && (
                  <span class="mt-0.5 block truncate text-sm text-muted">+ {g.expansions.map((e) => e.name).join(', ')}</span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 grid gap-5 sm:grid-cols-3">
    {
      features.map((f) => (
        <div class="chunk p-5">
          <div class="text-3xl">{f.emoji}</div>
          <h2 class="mt-2 font-display text-xl font-semibold">{f.title}</h2>
          <p class="mt-1 text-muted">{f.text}</p>
        </div>
      ))
    }
  </section>
</Layout>

<script>
  const input = document.getElementById('game-search') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('#game-list > li')];
  const empty = document.getElementById('no-results')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const match = li.dataset.name!.includes(q);
      li.hidden = !match;
      if (match) shown++;
    }
    empty.classList.toggle('hidden', shown > 0);
  });
</script>
